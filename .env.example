# 복사해서 .env 로 저장하세요 (.env 는 git 에 올라가지 않습니다)

# live = 공식 trade2 API 사용 / mock = 오프라인 가짜 매물 (기본: live)
TRADE_MODE=live

# GGG 는 서드파티 툴에 연락처가 담긴 User-Agent 를 요구합니다. 본인 이메일/디스코드 등을 넣으세요.
POE2LAB_CONTACT=

# 은신처 순간이동(Travel to Hideout)용. 브라우저에서 pathofexile.com 로그인 후 쿠키 POESESSID 값.
# 비워두면 순간이동 버튼 대신 귓속말 복사/거래소 열기만 제공합니다. 절대 남에게 공유하지 마세요.
POESESSID=

PORT=3000
